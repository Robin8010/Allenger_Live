<core:FragmentDefinition xmlns="sap.m"  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core">
    <Panel headerText="PRODUCT INSPECTION DETAILS:" expandable="true" expanded="false" expand=".onPanelExpand">
         <Panel headerText="Product Details:- " expandable="true" expanded="true" expand=".onPanelExpand">
        <VBox>

         <f:SimpleForm backgroundDesign="Solid"
                editable="true"
                layout="ResponsiveGridLayout"
                maxContainerCols="3"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="3"
                emptySpanM="3"
                emptySpanS="0"
            >
                <f:content>
                <core:Title text="" />
                      
                      
                        <Label
                            id="ElectricalQA"
                            text="{i18n>Electrical QA}"
                           
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="_ElectricalQA"
                            value="{EntryFormDataSourceModel>/ElectricalQA}"
                           
                            enabled="false"
                            class="m-mast-input"
                        />
                          <Label
                            id="ElectricalDate"
                            text="{i18n>Electrical Date}"
                           
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="_ElectricalDate"
                            value="{EntryFormDataSourceModel>/ElectricalDate}"
                           enabled="false"
                           
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                        
                           <Label
                            id="MechanicalQA"
                            text="{i18n>Mechanical QA}"
                            
                            class="m-mast-lev"
                        /> 
                        
                          <Input
                            id="_MechanicalQA"
                            value="{EntryFormDataSourceModel>/MechanicalQA}"
                           
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="MechanicalDate"
                            text="{i18n>Mechanical Date}"
                           
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="_MechanicalDate"
                            value="{EntryFormDataSourceModel>/MechanicalDate}"
                           enabled="false"
                           
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                         <Label
                            id="deviation"
                            text="Is there any deviation required: "
                           
                            class="m-mast-lev"
                           
                        />  
                        <ComboBox 
                            id="_cmbElectrical"
                           
                            valueState="None"
                            change="onComboSelection"
                            selectedKey="{EntryFormDataSourceModel>/deviation}"
                            items="{EntryFormDataSourceModel>/List}">

                            <core:Item 
                                key="{EntryFormDataSourceModel>ID}"
                                text="{EntryFormDataSourceModel>Code}"/>
                        </ComboBox>
                           
                           
                        
                        <Label
                            id="deviationNo"
                            text="If Yes, mention deviation No.  "
                            required="true"
                            class="m-mast-lev"
                           
                        /> 
                        <Input
                            id="_deviationNo"
                            value="{EntryFormDataSourceModel>/deviationNo}"
                           
                            enabled="true"
                           
                            class="m-mast-input"
                            change="ValidateQuantity"
                           
                        /> 
<core:Title text="" />  
                        
                        
                                             
                        <Label
                            id="ElectricalPerson"
                            text="{i18n>Person Authorized for inspection  of Export Machine. }"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="_ElectricalPerson"
                            value="{EntryFormDataSourceModel>/PersanAUthorizedforInspection}"
                            required="true"
                            enabled="true"
                            class="m-mast-input"
                        />
                        <Label
                            id="Date"
                            text="{i18n> Date}"
                           
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="_Date"
                            value="{EntryFormDataSourceModel>/PADate}"
                           enabled="true"
                           
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                           <Label
                            id="ProductSpecilist"
                            text="{i18n>Product Specialist Approval (For Machine under Pre Yellow/Yellow Certificate)}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        
                          <Input
                            id="_ProductSpecilist"
                            value="{EntryFormDataSourceModel>/ProductSpecilistApproval}"
                            required="true"
                            enabled="true"
                            class="m-mast-input"
                        />

                         <Label
                            id="PSDate"
                            text="{i18n> Date}"
                           
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="_PSDate"
                            value="{EntryFormDataSourceModel>/PSDate}"
                           enabled="true"
                           
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                         <Label
                            id="SpecialInstruction"
                            text="{i18n>Special Instruction}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        
                           <TextArea
                            value="{EntryFormDataSourceModel>/SpecialInstruction}"
                            growing="true"
                            growingMaxLines="10"
                        
                            placeholder="Enter description..." />

                           
      

                </f:content>
            </f:SimpleForm>

           
        </VBox>
    </Panel>
    </Panel>
</core:FragmentDefinition>