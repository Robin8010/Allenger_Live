<core:FragmentDefinition xmlns="sap.m"
 xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core">
    <Panel headerText="Approval For Product Dismentling " expandable="true" expanded="true" expand=".onPanelExpand">
        <VBox>

         <f:SimpleForm backgroundDesign="Solid"
                editable="true"
                layout="ResponsiveGridLayout"
                 maxContainerCols="3"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="3"
                emptySpanM="3"
                emptySpanS="0"
            >
                <f:content>
                <core:Title text="" />
                      <Label
                            id="FinalClearanceBy"
                            text="{i18n>Final Clearance By}"
                         
                            class="m-mast-lev"
                        /> 
                       <Input
                            id="_FinalClearBy"
                            value="{EntryFormDataSourceModel>/FinalClearBy}"
                             maxLength="35"
                            enabled="true"
                            class="m-mast-input"
                        />                     
                        
                      
                        <Label
                            id="FinalApprovalBy"
                            text="{i18n>Final Approval By}"
                           
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="_FinalApprovalBy"
                            value="{EntryFormDataSourceModel>/FinalApprovalBy}"
                             maxLength="35"
                            enabled="true"
                            class="m-mast-input"
                        />
                         <Label
                            id="PackingEnsuredBy"
                            text="{i18n>Packing Ensured By}"
                           
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="_PackingEnsuredBy"
                            value="{EntryFormDataSourceModel>/PackingEnsuredBy}"
                             maxLength="35"
                            enabled="true"
                            class="m-mast-input"
                        />

                            <Label
                            id="PackingEnsuredByDate"
                            text="{i18n>Packing Ensured By Date}"
                           
                            class="m-mast-lev"
                        /> 
                       <DatePicker
                            id="_PENSDate"
                            value="{EntryFormDataSourceModel>/PEByDate}"
                           enabled="true"
                           
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                          <core:Title text="" />

                             <Label
                            id="FinalClearanceByDate"
                            text="{i18n>Final Clearance By Date}"
                           
                            class="m-mast-lev"
                        /> 

                         <DatePicker
                            id="_FinalClearByDate"
                            value="{EntryFormDataSourceModel>/FinalClearByDate}"
                           enabled="true"
                           
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                                         
                        
                      
                        <Label
                            id="FinalApprovalByDate"
                            text="{i18n>Final Approval By Date}"
                           
                            class="m-mast-lev"
                        /> 
                           <DatePicker
                            id="_FinalApprovalByDate"
                            value="{EntryFormDataSourceModel>/FinalApprovalByDate}"
                           enabled="true"
                           
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                      
                </f:content>
            </f:SimpleForm>

           
        </VBox>
    </Panel>
</core:FragmentDefinition>