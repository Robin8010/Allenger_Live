<core:FragmentDefinition xmlns="sap.m"
 xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core">
    <Panel headerText="Approval For Product Dismentling " expandable="true" expanded="true" expand=".onPanelExpand">
        <VBox>

         <f:SimpleForm backgroundDesign="Solid"
                editable="true"
                layout="ResponsiveGridLayout"
                maxContainerCols="3"
                labelSpanXL="2"
                labelSpanL="2"
                labelSpanM="2"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="3"
                emptySpanM="3"
                emptySpanS="0"
            >
                <f:content>
                <core:Title text="" />
                      <Label
                            id="FinalClearanceBy"
                            text="{i18n>Final Clearance By}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                       <Input
                            id="_FinalClearBy"
                            value="{EntryFormDataSourceModel>/FinalClearBy}"
                            required="true"
                            enabled="true"
                            class="m-mast-input"
                        />                     
                        
                      
                        <Label
                            id="FinalApprovalBy"
                            text="{i18n>Final Approval By}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="_FinalApprovalBy"
                            value="{EntryFormDataSourceModel>/FinalApprovalBy}"
                            required="true"
                            enabled="true"
                            class="m-mast-input"
                        />
                         
                          

                </f:content>
            </f:SimpleForm>

           
        </VBox>
    </Panel>
</core:FragmentDefinition>