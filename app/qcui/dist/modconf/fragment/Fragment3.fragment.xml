<core:FragmentDefinition xmlns="sap.m"  
xmlns:f="sap.ui.layout.form"
 xmlns:core="sap.ui.core">
    <Panel headerText="CHECKLIST OF DOCUMENTS REQUIRED BEFORE CLEARANCE FOR DISMANTLING:" expandable="true" expanded="false" expand=".onPanelExpand">
        
 <VBox >



 <Table id="_Tbl"  
  width="100%"
    growing="true"
    growingScrollToLoad="true"
    items="{EntryFormDataSourceModel>/LineItem}"  
  class="sapUiSizeCompact"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    headerLevel="Auto"                    
                    backgroundDesign="Translucent">
  <headerToolbar>
  <Toolbar >
  <content>
    

  </content>
  </Toolbar>
  </headerToolbar>
							<columns>
          
								<Column>
									<Label text="Document Name"/>
								</Column>
								<Column>
									<Label text="Click if Document Atteched"/>
								</Column>
							
							
               
							</columns>
							<items>
								<ColumnListItem>
								<cells>
                  	         <Text text="{EntryFormDataSourceModel>DocumentNum}"/>
										 <CheckBox   select=".onCheckBoxSelect"
                           selected="{EntryFormDataSourceModel>IsDocumentAtteched}" />

                	</cells>
								</ColumnListItem>
							</items>
						</Table>

          

  </VBox>      
    </Panel>
</core:FragmentDefinition>