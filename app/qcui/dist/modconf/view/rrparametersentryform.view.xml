<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    controllerName="modconfcontroller.rrparametersentryform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
>
    <Page
        id="rrparametersf"
        title="Record Result Parameters"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
       
          <f:SimpleForm
            editable="true"
            layout="ResponsiveLayout"
            labelSpanXL="6"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="3"
            emptySpanL="3"
            emptySpanM="3"
            emptySpanS="3">
                <f:content  >
              
                <HBox alignItems="Center"  >
                    <Label
                        id="serialBatchlbl"
                        text="{i18n>SerialBatchNumber}"
                        required="true"
                        class="sapUiMediumMarginEnd"
                    />
                  
                    <Input
                        id="rwContactID"
                        value="{EntryFormDataSourceModel>/SerialBatchNumber}"
                        required="true"
                        enabled="false"
                        class="sapUiMediumMarginEnd"
                    />
                    </HBox>
                    <HBox alignItems="Center">
                    <Label
                        id="rwQuantitylbl"
                        text="{i18n>Quantity}"
                        required="true"
                        class="sapUiMediumMarginEnd"
                    />
                    <Input
                        id="crQuantity"
                        value="{EntryFormDataSourceModel>/Quantity}"
                        required="true"
                        enabled="false"
                         class="sapUiMediumMarginEnd"
                    />   
                    </HBox>
                    <HBox alignItems="Center">
                    <Label
                        id="crStatuslbl"
                        text="{i18n>Status}"
                        required="true"
                        class="sapUiMediumMarginEnd"
                    />
                    <Input
                        id="crStatus"
                        value="{EntryFormDataSourceModel>/Status}"
                        required="true"
                        enabled="false"
                         class="sapUiMediumMarginEnd"
                    />
                    </HBox>
                   
                </f:content>
            </f:SimpleForm>
       
        <VBox>
          <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                    <Button
                        icon="sap-icon://add"
                        text="{i18n>addNew}"
                        press="addRow"
                        visible="false"
                    />
                </VBox>
            </HBox>
            <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                     <SearchField placeholder="Search" liveChange="onSearch" value="{EntryFormDataSourceModel>/SearchRecord}"></SearchField>
                      <Input id="cPperameter" showValueHelp="true" value="{EntryFormDataSourceModel>/InspectionLot}" valueHelpRequest="cflForInspectionLot"      placeholder="Select Inspection Lot" change="ChangeInspectionLot" enabled="true" />
                     <HBox  justifyContent="End">   <Button  type="Emphasized" id="Cp_Perameter" text="CopyPerameter"  press="onPressCopyPerameter"  />
                     </HBox>
                </VBox>
            </HBox>
            <ScrollContainer
                width="100%"
                height="400px"
                horizontal="true"
                vertical="true">
                <Table
                    id="smParameterTable1"
                    items="{
                        path: 'EntryFormDataSourceModel>/ParametersDetails'
                    }"
                    class="sapUiSizeCompact"
                    inset="true"
                     width="auto"
                    fixedLayout="false"
                    sticky="ColumnHeaders,HeaderToolbar"
                    growing="true"
                    growingScrollToLoad="true"
                   
                    showSeparators="All"
                    showNoData="true"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    backgroundDesign="Translucent"
                    
                >
                    <columns>
                        <Column>
                            <Label text="Sr No"  />
                        </Column>
                        <Column>   
                         <Label tooltip="Parent Parameter Id"
                                text="Parent Parameter Id"
                                labelFor="ParentParameterCode"
                            />
                        </Column>
                         <Column  width="25%">
                            <Label tooltip="Parent Parameter Description"
                                text="Parent Parameter Description"
                                labelFor="ParentParameterName"
                            />
                        </Column> 
                         
                         <Column Width="300"
                             demandPopin="false">
                            <Label
                                text="Parameter Id"
                                labelFor="ParameterCode"
                                wrapping="true"
                                
                            />
                        </Column>
                       <Column  width="20%">
                            <Label tooltip="Parameter Description"
                                text="Parameter Description"
                                labelFor="ParameterName"
                               
                            />
                        </Column>
                        
                        <Column>
                            <Label tooltip="Range From"
                                text="Range From"
                                labelFor="Range From"
                            />
                        </Column>
                        <Column>
                            <Label tooltip="Range To"
                                text="Range To"
                                labelFor="Range To"
                            />
                        </Column> 

                         <Column>
                            <Label tooltip="UOM"
                                text="Uom"
                                labelFor="Uom"
                            />
                        </Column>     
                        <Column>
                            <Label tooltip="Characteristic/Attribute"
                                text="Characteristic/Attribute"
                                labelFor="Attribute"
                            />
                        </Column>
                        <Column>
                            <Label tooltip="DeviceGroupID"
                                text="DeviceGroupID"
                                labelFor="DeviceGroupID"
                            />
                        </Column>
                        <Column>
                            <Label tooltip="DeviceGroup"
                                text="DeviceGroup"
                                labelFor="DeviceGroup"
                            />
                        </Column>
                         <Column>
                            <Label tooltip="Actual Result/Observation"
                                text="Actual Result/Observation"
                                labelFor="Observation"
                            />
                        </Column>
                        <Column>
                            <Label tooltip="Inspection Agency "
                                text="Inspection Agency "
                                labelFor="InspectionAgency"
                            />
                        </Column>
                         
                        <Column width="40px">
                            <Label
                                text="Status"
                                labelFor="Status"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Remarks1"
                                labelFor="Remarks1"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Remarks2"
                                labelFor="Remarks2"
                            />
                        </Column>       
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle" >
                            <cells>
                                <Text
                                    id="il_SrNo1"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <Text
                                    id="il_PParameterCode1"
                                    text="{EntryFormDataSourceModel>ParentParameterCode}"
                                    wrapping="true"
                                />
                                 <Text
                                    id="il_PParameterName1"
                                    text="{EntryFormDataSourceModel>ParentParameterName}"
                                    wrapping="true"
                                />
                               
                                
                                 <Text
                                    id="il_ParameterCode1"
                                    text="{EntryFormDataSourceModel>ParameterCode}"
                                    wrapping="true"
                                /> 
                              <Text
                                    id="il_ParameterName1"
                                    text="{EntryFormDataSourceModel>ParameterName}"
                                    wrapping="true"
                                />
                                 <Text
                                    id="il_RangeF"
                                    text="{EntryFormDataSourceModel>Lowervalue}"
                                    wrapping="true"
                                />
                                 <Text
                                    id="il_RangeT"
                                    text="{EntryFormDataSourceModel>Uppervalue}"
                                    wrapping="true"
                                />
                                  <Text
                                    id="il_UOM"
                                    text="{EntryFormDataSourceModel>UOM}"
                                    wrapping="true"
                                />
                                <Text
                                    id="il_Attribute1"
                                    text="{EntryFormDataSourceModel>Attribute}"
                                    wrapping="true"
                                />
                                <Text
                                    id="il_DeviceGroupID"
                                    text="{EntryFormDataSourceModel>DeviceGroupID}"
                                    wrapping="true"
                                />
                                <Text
                                    id="il_DeviceGroup"
                                    text="{EntryFormDataSourceModel>DeviceGroup}"
                                    wrapping="true"
                                />
                                <TextArea
                                    id="il_Observation1"
                                    value="{EntryFormDataSourceModel>Observation}"
                                    growing="true"
                                    
                                    editable="{EntryFormDataSourceModel>StatusEnableDisable}"
                                    liveChange="HandleLiveChanges"
                                />
                                <Text
                                    id="il_InstrumentId1"
                                    text="{EntryFormDataSourceModel>InspectionAgency}"
                                />
                               
                                <ComboBox  width="100px"
                                    id="rrpStatus"
                                    required="true"
                                    valueState="None"
                                    change="onComboSelection"
                                    visible="true"
                                    editable="{EntryFormDataSourceModel>StatusEnableDisable}"
                                    selectedKey="{EntryFormDataSourceModel>Status}"
                                    items="{EntryFormDataSourceModel>/ParameterStatusList}"
                                > 
                                    <core:Item 
                                        key="{EntryFormDataSourceModel>StatusId}"
                                        text="{EntryFormDataSourceModel>StatusDesc}"
                                    />
                                </ComboBox>
                                <TextArea                                    
                                    id="il_Remarks11"
                                    value="{EntryFormDataSourceModel>Remarks1}"  
                                    growing="true"                                  
                                />
                                <TextArea
                                    id="il_Remarks21"
                                    value="{EntryFormDataSourceModel>Remarks2}"
                                    growing="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button
                    type="Emphasized"
                    id="CADS_Button"
                    text="{i18n>submit}"
                    press="onSave"
                />
                 <Button
                    type="Emphasized"
                    id="CADC_Button"
                    text="{i18n>cancel}"
                    press="onCancel"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>