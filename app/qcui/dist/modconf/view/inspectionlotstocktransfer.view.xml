<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    controllerName="modconfcontroller.inspectionlotstocktransfer"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
>
    <Page
        id="ilstocktransferf"
        title="Stock Transfer Form"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm backgroundDesign="Solid"
                editable="true"
                layout="ResponsiveGridLayout"
                maxContainerCols="3"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="3"
                emptySpanM="3"
                emptySpanS="0"
            >
                <f:content>
                <core:Title text="" />
                      <Label
                            id="idlbl"
                            text="{i18n>ID}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inID"
                            value="{EntryFormDataSourceModel>/ID}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />  
                        <Label
                            id="statuslbl"
                            text="{i18n>Status}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inSStatus"
                            value="{EntryFormDataSourceModel>/Status}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="stockTypelbl"
                            text="{i18n>Stock Type}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <ComboBox
                            id="rrStockType"
                            required="true"
                            valueState="None"
                            visible="true"
                            editable="{EntryFormDataSourceModel>/StockTypeEditable}"
                            selectedKey="{EntryFormDataSourceModel>/UsageDecisionStockType}"
                            items="{EntryFormDataSourceModel>/UsageDecisionStockTypeList}"
                        > 
                            <core:Item 
                                key="{EntryFormDataSourceModel>StockTypeId}"
                                text="{EntryFormDataSourceModel>StockTypeDesc}"
                            />
                        </ComboBox>
                        <Label
                            id="storageLocationbl"
                            text="{i18n>Storage Location}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <ComboBox
                            id="rrStorageLocation"
                            required="true"
                            valueState="None"
                            visible="true"
                            editable="{EntryFormDataSourceModel>/SorageLocationEditable}"
                            selectedKey="{EntryFormDataSourceModel>/StorageLocation}"
                            items="{EntryFormDataSourceModel>/StorageLocationList}"
                        > 
                        <core:Item 
                            key="{EntryFormDataSourceModel>StorageLocation}"
                            text="{EntryFormDataSourceModel>StorageLocationName}"
                        />
                        </ComboBox>                        
                         <core:Title text="" />                      
                        <Label
                            id="postdatelbl"
                            text="{i18n>PostDate}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="dtpostDate"
                            value="{EntryFormDataSourceModel>/PostDate}"
                            required="true"
                            enabled="{EntryFormDataSourceModel>/PostDateEnabled}"                            
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                        <Label
                            id="quantitylbl"
                            text="{i18n>Quantity}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inQuantity"
                            value="{EntryFormDataSourceModel>/Quantity}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />   
                        <Label
                            id="createdBylbl"
                            text="{i18n>CreatedBy}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inCreatedBy"
                            value="{EntryFormDataSourceModel>/CreatedBy}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />           
                </f:content>
            </f:SimpleForm>
        </VBox>   
        <VBox>
        <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                     <SearchField placeholder="Search" liveChange="onSearch" value="{EntryFormDataSourceModel>/SearchRecord}"></SearchField>
                </VBox>
            </HBox>
         
            <ScrollContainer
                width="100%"
                height="300px"
                horizontal="true"
                vertical="true"
            >
                <Table
                    id="smSerialBatchDetails"
                    items="{
                        path: 'EntryFormDataSourceModel>/RecordResultDecisionDetail'
                    }"
                    class="sapUiSizeCompact"
                    inset="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    autoPopinMode="true"
                    growing="true"
                    growingScrollToLoad="true"
                    headerLevel="Auto"                    
                    backgroundDesign="Translucent"
                >
                    <columns>
                        <Column>
                            <Label text="Sr No" />
                        </Column>
                        <Column>
                            <Label text="Select" />
                        </Column>
                        <Column>
                            <Label
                                text="ID"
                                labelFor="SerialBatchNumberID"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Serial No."
                                labelFor="SerialBatchNumber"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Quantity"
                                labelFor="Quantity"
                            />
                        </Column>      
                         <Column>
                            <Label
                                text="Status"
                                labelFor="Status"
                            />
                        </Column>  
                        <!-- <Column>
                           
                        </Column>
                        <Column>
                           
                        </Column> -->
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text
                                    id="il_SrNo"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <CheckBox
                                    id="il_Select"
                                    enabled="{EntryFormDataSourceModel>PostDataEnable}"
                                    selected="{EntryFormDataSourceModel>PostData}"                                    
                                />
                                 <Text
                                    id="il_SerialBatchNumberID"
                                    text="{EntryFormDataSourceModel>SerialBatchNumberID}"
                                />
                                <Text
                                    id="il_SerialBatchNumber"
                                    text="{EntryFormDataSourceModel>SerialBatchNumber}"
                                />
                                <Text
                                    id="il_Quantity"
                                    text="{EntryFormDataSourceModel>Quantity}"
                                />
                                <Text
                                    id="il_Status"
                                    text="{EntryFormDataSourceModel>Status}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>     
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button
                    type="Emphasized"
                    id="stocktransfer_Save"
                    text="{i18n>Save Draft}"
                    press="onSave"
                    enabled="{EntryFormDataSourceModel>/SaveButton}"
                />
                <!-- <Button
                    type="Emphasized"
                    id="stocktransfer_Button"
                    text="{i18n>Post Transfer}"
                    press="onPostRecordResult"                    
                    enabled="{EntryFormDataSourceModel>/SubmitButtonEnabled}"                            
                /> -->
                <Button
                    type="Emphasized"
                    id="stocktransferCancel_Button"
                    text="{i18n>Cancel}"
                    press="onCancel"
                />
                <Button
                    type="Emphasized"
                    id="stocktransfer_Post"
                    text="{i18n>Post Transfer}"
                    press="onPostStockTransfer"
                    enabled="{EntryFormDataSourceModel>/PostButton}"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>