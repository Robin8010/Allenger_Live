<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    controllerName="modconfcontroller.recordresultsapentryform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
>
    <Page
        id="recordresultsapf"
        title="Record Result Form"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm backgroundDesign="Solid"
                editable="true"
                layout="ResponsiveGridLayout"
                maxContainerCols="3"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="3"
                emptySpanM="3"
                emptySpanS="0"
            >
                <f:content>
                <core:Title text="" />
                      <Label
                            id="inspectionlotlbl"
                            text="{i18n>inspectionlot}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inspectionLot"
                            value="{EntryFormDataSourceModel>/InspectionLot}"
                            required="true"
                            enabled="{EntryFormDataSourceModel>/InspectionLotEnabled}"
                            class="m-mast-input"
                            showValueHelp="true"
                            valueHelpRequest="cflForInspectionLot"     
                            placeholder="Select Inspection Lot"
                            change="ChangeInspectionLot"                       
                        />
                        <Label
                            id="materiallbl"
                            text="{i18n>Material}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inMaterial"
                            value="{EntryFormDataSourceModel>/Material}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="plantlbl"
                            text="{i18n>Plant}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inPlant"
                            value="{EntryFormDataSourceModel>/Plant}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="manageBylbl"
                            text="{i18n>Managed By}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inManageBy"
                            value="{EntryFormDataSourceModel>/ManagedBy}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />                        
                        <Label
                            id="statuslbl"
                            text="{i18n>Status}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inSStatus"
                            value="{EntryFormDataSourceModel>/Status}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />  
                        
                         <core:Title text="" />                      
                        <Label
                            id="postdatelbl"
                            text="{i18n>PostDate}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="dtpostDate"
                            value="{EntryFormDataSourceModel>/PostDate}"
                            required="true"
                            enabled="{EntryFormDataSourceModel>/PostDateEnabled}"                            
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                        <Label
                            id="eoilbl"
                            text="{i18n>EndOfInspection}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inEOI"
                            value="{EntryFormDataSourceModel>/EOI}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="quantitylbl"
                            text="{i18n>Quantity}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inQuantity"
                            value="{EntryFormDataSourceModel>/Quantity}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="acceptedQtylbl"
                            text="{i18n>Accepted Quantity}"
                            required="true"
                            class="m-mast-lev"
                            visible="false"
                        /> 
                        <Input
                            id="inAcceptedQty"
                            value="{EntryFormDataSourceModel>/AcceptedQuantity}"
                            required="true"
                            enabled="true"
                            type="Number"
                            class="m-mast-input"
                            change="ValidateQuantity"
                            visible="false"
                        />
                        <Label
                            id="rejectedQtylbl"
                            text="{i18n>Rejected Quantity}"
                            required="true"
                            class="m-mast-lev"
                            visible="false"
                        /> 
                        <Input
                            id="inRejectedQty"
                            value="{EntryFormDataSourceModel>/RejectedQuantity}"
                            required="true"
                            enabled="true"
                            type="Number"
                            class="m-mast-input"
                            change="ValidateQuantity"
                            visible="false"
                        /> 
                        <Label
                            id="documentSummarylbl"
                            text="{i18n>Document Summary}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="indocumentSummary"
                            value="{EntryFormDataSourceModel>/DocumentSummary}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"                            
                        />  
                          <Label
                            id="productionOrderlbl"
                            text="{i18n>Production Order}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inProduction"
                            value="{EntryFormDataSourceModel>/ManufacturingOrder}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"                            
                        />                        
                </f:content>
            </f:SimpleForm>
        </VBox>   
        <VBox>
        <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                     <SearchField placeholder="Search" liveChange="onSearch" value="{EntryFormDataSourceModel>/SearchRecord}"></SearchField>
                </VBox>
            </HBox>
         
            <ScrollContainer
                width="100%"
                height="300px"
                horizontal="true"
                vertical="true"
            >
                <Table
                    id="smSerialBatchDetails"
                    items="{
                        path: 'EntryFormDataSourceModel>/SerialBatchDetails'
                    }"
                    class="sapUiSizeCompact"
                    inset="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    autoPopinMode="true"
                    growing="true"
                    growingScrollToLoad="true"
                    headerLevel="Auto"                    
                    backgroundDesign="Translucent"
                >
                    <columns>
                        <Column>
                            <Label text="Sr No" />
                        </Column>
                        <Column>
                            <Label
                                text="Serial/Batch No."
                                labelFor="SerialBatchNumber"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Quantity"
                                labelFor="Quantity"
                            />
                        </Column>      
                         <Column>
                            <Label
                                text="Status"
                                labelFor="Status"
                            />
                        </Column>
                        <!-- <Column>
                            <Label
                                text="Stock Type"
                                labelFor="UsageDecisionStockType"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Storage Location"
                                labelFor="StorageLocation"
                            />
                        </Column>        -->
                        <Column>
                           
                        </Column>
                        <Column>
                           
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text
                                    id="il_SrNo"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <Text
                                    id="il_SerialBatchNumber"
                                    text="{EntryFormDataSourceModel>SerialBatchNumber}"
                                />
                                <Text
                                    id="il_Quantity"
                                    text="{EntryFormDataSourceModel>Quantity}"
                                />
                                <Input 
                                    id="rrStatus"
                                    enabled="false"
                                    value="{EntryFormDataSourceModel>Status}"
                                ></Input>
                                <!-- <ComboBox
                                    id="rrStockType"
                                    required="true"
                                    valueState="None"
                                    visible="true"
                                    editable="{EntryFormDataSourceModel>StockTypeEditable}"
                                    selectedKey="{EntryFormDataSourceModel>UsageDecisionStockType}"
                                    items="{EntryFormDataSourceModel>/UsageDecisionStockTypeList}"
                                > 
                                    <core:Item 
                                        key="{EntryFormDataSourceModel>StockTypeId}"
                                        text="{EntryFormDataSourceModel>StockTypeDesc}"
                                    />
                                </ComboBox>
                                 <ComboBox
                                    id="rrStorageLocation"
                                    required="true"
                                    valueState="None"
                                    visible="true"
                                    editable="{EntryFormDataSourceModel>SorageLocationEditable}"
                                    selectedKey="{EntryFormDataSourceModel>StorageLocation}"
                                    items="{EntryFormDataSourceModel>/StorageLocationList}"
                                > 
                                    <core:Item 
                                        key="{EntryFormDataSourceModel>StorageLocation}"
                                        text="{EntryFormDataSourceModel>StorageLocationName}"
                                    />
                                </ComboBox> -->
                                <!-- <ComboBox
                                    id="rrStatus"
                                    required="true"
                                    valueState="None"
                                    visible="true"
                                    editable="false"
                                    selectedKey="{EntryFormDataSourceModel>Status}"
                                    items="{path: 'EntryFormDataSourceModel>/StatusList',templateShareable: true}"
                                > 
                                    <core:Item 
                                        key="{EntryFormDataSourceModel>StatusId}"
                                        text="{EntryFormDataSourceModel>StatusDesc}"
                                    />
                                </ComboBox> -->
                            </cells>
                            <cells>
                                <Button  
                                    visible="{EntryFormDataSourceModel>AddParameters}" 
                                    width="35px" 
                                    icon="sap-icon://open-command-field" 
                                    type="Success"
                                    fieldHelpDisplay="Parameters"
                                    press="onPressParameters"/>
                                 <Button  
                                    visible="{EntryFormDataSourceModel>CopyParameters}" 
                                    width="35px" 
                                    icon="sap-icon://copy" 
                                    type="Success"
                                    fieldHelpDisplay="Parameters"
                                    press="onPressCopyParameters"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>     
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button
                    type="Emphasized"
                    id="recordResultSAP_Save"
                    text="{i18n>Save Draft}"
                    press="onSave"
                />
                <!-- <Button
                    type="Emphasized"
                    id="recordResultSAP_Button"
                    text="{i18n>Post Transfer}"
                    press="onPostRecordResult"                    
                    enabled="{EntryFormDataSourceModel>/SubmitButtonEnabled}"                            
                /> -->
                <Button
                    type="Emphasized"
                    id="recordResultSAPCancel_Button"
                    text="{i18n>Cancel}"
                    press="onCancel"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>