                <TileContent id="tc5">
                    <ImageContent id="ic5" src="sap-icon://decision" />
                </TileContent>
            </GenericTile>

             <GenericTile id="gt6" class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Record result decision "
                subheader="List Report" press="Showrecordresult" url="https://www.sap.com/">
                <TileContent id="tc6">
                    <ImageContent id="ic6" src="sap-icon://decision" />
                </TileContent>
            </GenericTile>

                <GenericTile id="gt7" visible="true" class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Product Quality Assurance"
                subheader="Product Quality Assurance" press="ShowproductQuality" url="https://www.sap.com/">
                <TileContent id="tc7">
                    <ImageContent id="ic7" src="sap-icon://decision" />
                </TileContent>
            </GenericTile>
