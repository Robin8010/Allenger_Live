                    <ImageContent id="ic4" src="test-resources/sap/m/demokit/sample/GenericTileAsLaunchTile/images/SAPLogoLargeTile_28px_height.png" />
                </TileContent>
            </GenericTile>
            <GenericTile id="gt5" class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="User Decision"
