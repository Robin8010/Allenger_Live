<mvc:View controllerName="qcui.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:cor="sap.ui.core"
    xmlns:tnt="sap.tnt">
    	 <tnt:ToolPage id="appNew" class="sapUiDemoToolPage" sideExpanded="false">     
       <!-- ShellBar at the top -->
     
        <tnt:header>
       
          <tnt:ToolHeader id="shellLikeToolHeader"  visible="{oAppModel>/enableToolHeader}">
			<Button icon="sap-icon://menu2" visible="false" type="Transparent" press="onCollapseExpandPress" tooltip="Menu">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow"/>
				</layoutData>
			</Button>
			<Image src="test-resources/sap/tnt/images/SAP_Logo.png" decorative="false" press="onLogoPressed" tooltip="SAP Logo">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow"/>
				</layoutData>
			</Image>
			<Title text="BTP QUALITY MANAGEMENT DESHBOARD" wrapping="false" id="productName">
				<layoutData>
					<OverflowToolbarLayoutData priority="Disappear"/>
				</layoutData>
			</Title>
			<Text text="Second title" visible="false" wrapping="false" id="secondTitle">
				<layoutData>
					<OverflowToolbarLayoutData priority="Disappear"/>
				</layoutData>
			</Text>
			<ToolbarSpacer />
			<SearchField width="16rem" id="searchField" visible="false">
				<layoutData>
					<OverflowToolbarLayoutData priority="Low" group="1"/>
				</layoutData>
			</SearchField>
			<ToolbarSpacer id="spacer">
				<layoutData>
					<OverflowToolbarLayoutData priority="Low" group="1"/>
				</layoutData>
			</ToolbarSpacer>
			<Button visible="false" icon="sap-icon://search" type="Transparent" id="searchButton" tooltip="Search"/>
			<OverflowToolbarButton visible="false" icon="sap-icon://source-code" type="Transparent" tooltip="Action 1" text="Action 1">
				<layoutData>
					<OverflowToolbarLayoutData group="2"/>
				</layoutData>
			</OverflowToolbarButton>
			<OverflowToolbarButton visible="false" icon="sap-icon://card" type="Transparent" tooltip="Action 2" text="Action 2">
				<layoutData>
					<OverflowToolbarLayoutData group="2"/>
				</layoutData>
			</OverflowToolbarButton>
			<ToolbarSeparator>
				<layoutData>
					<OverflowToolbarLayoutData group="2"/>
				</layoutData>
			</ToolbarSeparator>
			<Label design="Bold"  text="{sysModel>/userDetails/UserDsc}" />
			<OverflowToolbarButton visible="false" icon="sap-icon://action-settings" type="Transparent" text="Settings"/>
			<Button icon="sap-icon://bell" visible="false" type="Transparent" tooltip="Notification">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow"/>
				</layoutData>
			</Button>
			<tnt:ToolHeaderUtilitySeparator/>
			<ToolbarSpacer width="1.125rem"/>
			<Avatar id="lnkLogout" src="sap-icon://account" displaySize="XS" press="handleLinkPress" tooltip="Profile">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow"/>
				</layoutData>
			</Avatar>
		</tnt:ToolHeader>
           
        </tnt:header>
        <tnt:mainContents>
        <App id="app">
        </App>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>