<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    controllerName="modconfcontroller.inspectionlotdecisionform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
>
    <Page
        id="inspectionLotDecisionf"
        title="Inspection Lot Decision Form"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm backgroundDesign="Solid"
                editable="true"
                layout="ResponsiveGridLayout"
                maxContainerCols="3"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="3"
                emptySpanM="3"
                emptySpanS="0"
            >
                <f:content>
                <core:Title text="" />
                      <Label
                            id="inspectionlotlbl"
                            text="{i18n>inspectionlot}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inInspectionLot"
                            value="{EntryFormDataSourceModel>/InspectionLot}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                            showValueHelp="true"
                            valueHelpRequest="cflForInspectionLot"     
                            placeholder="Select Inspection Lot"
                            change="ChangeInspectionLot"                       
                        />                        
                        <Label
                            id="materiallbl"
                            text="{i18n>Material}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inMaterial"
                            value="{EntryFormDataSourceModel>/Material}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="plantlbl"
                            text="{i18n>Plant}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inPlant"
                            value="{EntryFormDataSourceModel>/Plant}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="manageBylbl"
                            text="{i18n>Managed By}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inManageBy"
                            value="{EntryFormDataSourceModel>/ManagedBy}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />                        
                        <Label
                            id="statuslbl"
                            text="{i18n>Status}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inSStatus"
                            value="{EntryFormDataSourceModel>/Status}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />  
                        
                         <core:Title text="" />                      
                        <Label
                            id="postdatelbl"
                            text="{i18n>PostDate}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="dtpostDate"
                            value="{EntryFormDataSourceModel>/PostDate}"
                            required="true"
                            enabled="false"                            
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                        <Label
                            id="quantitylbl"
                            text="{i18n>Quantity}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inQuantity"
                            value="{EntryFormDataSourceModel>/Quantity}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="quantityTransfereslbl"
                            text="{i18n>Transfered Quantity}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inQuantityTransfered"
                            value="{EntryFormDataSourceModel>/TransferedQuantity}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="documentSummarylbl"
                            text="{i18n>Document Summary}"
                            required="true"
                            class="m-mast-lev"
                            visible="false"
                        /> 
                        <Label
                            id="createdBylbl"
                            text="{i18n>CreatedBy}"
                            required="true"
                            class="m-mast-lev"
                        />  
                         <Label
                            id="_RMK"
                            text="Remarks"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <TextArea
                            value="{EntryFormDataSourceModel>/Remarks}"
                            growing="true"
                            growingMaxLines="10"
                        
                            placeholder="Enter description..." />
                            <!--
                                <Input
                                    id="txtRemarks"
                                    value="{EntryFormDataSourceModel>/Remarks}"
                                    required="true"
                                    enabled="true"
                                    class="m-mast-input"
                                />  
                        -->                                          
                </f:content>
            </f:SimpleForm>
        </VBox>   
        <VBox>
        <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                     <Button type="Accept" text="New Transfer" press="onPressNewStockTransfer" 
                        enabled="{EntryFormDataSourceModel>/AddNewTransferEnable}"
						ariaDescribedBy="acceptButtonDescription genericButtonDescription">
					<layoutData>
						<FlexItemData growFactor="1" />
					</layoutData>
				</Button>
                </VBox>
            </HBox>
         
            <ScrollContainer
                width="100%"
                height="300px"
                horizontal="true"
                vertical="true"
            >
                <Table
                    id="smSerialBatchDetails"
                    items="{
                        path: 'EntryFormDataSourceModel>/RecordResultDecisionHead'
                    }"
                    class="sapUiSizeCompact"
                    inset="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    autoPopinMode="true"
                    growing="true"
                    growingScrollToLoad="true"
                    headerLevel="Auto"                    
                    backgroundDesign="Translucent"
                >
                    <columns>
                        <Column>
                            <Label text="Sr No" />
                        </Column>
                        <Column>
                            <Label
                                text="Stock Type"
                                labelFor="StockType"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Storage Location"
                                labelFor="StorageLocation"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Quantity"
                                labelFor="Quantity"
                            />
                        </Column>      
                         <Column>
                            <Label
                                text="Status"
                                labelFor="Status"
                            />
                        </Column>
                        <Column>
                        </Column>       
                        <!-- <Column>
                           
                        </Column>
                        <Column>
                           
                        </Column> -->
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text
                                    id="il_SrNo"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <ComboBox
                                    id="rrStockType"
                                    required="true"
                                    valueState="None"
                                    visible="true"
                                    editable="false"
                                    selectedKey="{EntryFormDataSourceModel>UsageDecisionStockType}"
                                    items="{EntryFormDataSourceModel>/UsageDecisionStockTypeList}"
                                > 
                                    <core:Item 
                                        key="{EntryFormDataSourceModel>StockTypeId}"
                                        text="{EntryFormDataSourceModel>StockTypeDesc}"
                                    />
                                </ComboBox>
                                <ComboBox
                                    id="rrStorageLocation"
                                    required="true"
                                    valueState="None"
                                    visible="true"
                                    editable="false"
                                    selectedKey="{EntryFormDataSourceModel>StorageLocation}"
                                    items="{EntryFormDataSourceModel>/StorageLocationList}"
                                > 
                                <core:Item 
                                    key="{EntryFormDataSourceModel>StorageLocation}"
                                    text="{EntryFormDataSourceModel>StorageLocationName}"
                                />
                                </ComboBox>
                                <Text
                                    id="il_Quantity"
                                    text="{EntryFormDataSourceModel>Quantity}"
                                />
                                <Text 
                                    id="rrStatus"
                                    text="{EntryFormDataSourceModel>Status}"
                                ></Text>
                            </cells>
                            <cells>
                                <Button  
                                    visible="true" 
                                    width="35px" 
                                    icon="sap-icon://open-command-field" 
                                    type="Success"
                                    fieldHelpDisplay="StockTransfer"
                                    press="onStockTransfer"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>     
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button
                    type="Emphasized"
                    id="stocktransfer_Save"
                    text="{i18n>Save Draft}"
                    press="onSave"
                    visible="false"
                />
                <!-- <Button
                    type="Emphasized"
                    id="stocktransfer_Button"
                    text="{i18n>Post Transfer}"
                    press="onPostRecordResult"                    
                    enabled="{EntryFormDataSourceModel>/SubmitButtonEnabled}"                            
                /> -->
                <Button
                    type="Emphasized"
                    id="stocktransferCancel_Button"
                    text="{i18n>Cancel}"
                    press="onCancel"
                />
                <Button
                    type="Emphasized"
                    id="ud_Post"
                    text="{i18n>Post UD}"
                    press="onPressUDPosting"
                    enabled="{EntryFormDataSourceModel>/PostUD}"
                />
                <Button
                    type="Emphasized"
                    id="stocktransfer_Status"
                    text="{i18n>Posted Status}"
                    press="UpdateStatusPosted"
                    visible="false"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>