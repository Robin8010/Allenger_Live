<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    xmlns:form="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="modconfcontroller.stocktransfersapview"
    displayBlock="true"
>
    <Page
        id="stocktransfersaplv"
        title="{i18n&gt;title}"
        showNavButton="true"
        navButtonPress="onPressBack"
    >
        <VBox>
        <HBox
            class="sapUiSmallMarginEnd"
            justifyContent="End"
        >
            <VBox>
                <SearchField placeholder="Search" liveChange="onSearch" value="{EntryFormDataSourceModel>/SearchRecord}"></SearchField>
            </VBox>
        </HBox>         
        <ScrollContainer
                width="100%"
                height="300px"
                horizontal="true"
                vertical="true"
            >
                <Table
                    id="smSerialBatchDetails"
                    items="{
                        path: 'EntryFormDataSourceModel>/value'
                    }"
                    class="sapUiSizeCompact"
                    inset="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    
                    growing="true"
                    growingScrollToLoad="true"
                    headerLevel="Auto"                    
                    backgroundDesign="Translucent"
                >
                    <columns>
                        <Column>
                            <Label text="Sr No" />
                        </Column>
                        <Column>
                            <Label
                                text="Inspection Lot"
                                labelFor="InspectionLot"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Serial"
                                labelFor="Serial"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Material"
                                labelFor="Material"
                            />
                        </Column>      
                         <Column>
                            <Label
                                text="Plant"
                                labelFor="Plant"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Post Date"
                                labelFor="PostDate"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Quantity"
                                labelFor="Quantity"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Status"
                                labelFor="Status"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Summary"
                                labelFor="Summary"
                            />
                        </Column>
                        <Column>
                           
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text
                                    id="il_SrNo"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <Text
                                    id="il_InspectionLot"
                                    text="{EntryFormDataSourceModel>InspectionLot}"
                                />
                                <Text
                               
                                    id="iSerial"
                                    text="viewSerial"
                                    
                                    tooltip="{EntryFormDataSourceModel>Serial}"
                                />
                                <Text 
                                    id="il_Material"
                                    text="{EntryFormDataSourceModel>Material}"
                                />
                                <Text
                                    id="il_Plant"
                                    text="{EntryFormDataSourceModel>Plant}"
                                ></Text>
                                <Text
                                    id="il_PostDate"
                                    text="{EntryFormDataSourceModel>PostDate}"
                                />
                                <Text
                                    id="il_Quantity"
                                    text="{EntryFormDataSourceModel>Quantity}"
                                />
                                <Text
                                    id="il_Status"
                                    text="{EntryFormDataSourceModel>Status}"
                                />
                                <Text
                                    id="il_Summary"
                                    text="{EntryFormDataSourceModel>Summary}"
                                />
                            </cells>
                            <cells>
                                <Button  
                                    visible="{EntryFormDataSourceModel>MakeDecision}" 
                                    width="35px" 
                                    icon="sap-icon://open-command-field" 
                                    type="Success"
                                    fieldHelpDisplay="Decision"
                                    press="onPressMakeDecision"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>
         <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
               <ToolbarSpacer />
                <Button
                    type="Emphasized"
                   
                    text="{i18n>Export}"
                    press="OnExport"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>