<mvc:View
     xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
      xmlns:f="sap.ui.layout.form"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    controllerName="modconfcontroller.ProductQualityAssurance">

         <Page title="Product Quality Assurance" showNavButton="true" navButtonPress="navBack">
 
        <!-- Filter Bar -->
  <VBox id="_Filter" class="sapUiSmallMargin">
     
       <f:SimpleForm
    id="_.ProductQualityList"
    layout="ResponsiveGridLayout"
    editable="true"
    columnsL="2"
    columnsM="1"
    labelSpanL="4"
    labelSpanM="4">

    <Input
        id="InspvdectionLot"
        width="100%"
        value="{EntryFormDataSourceModel>/Inspection}"
        showValueHelp="true"
        valueHelpRequest="cflForInspectionLot"
        placeholder="Inspection Lot" />

    <Input
        id="ManufacturingOrder"
        width="100%"
        value="{EntryFormDataSourceModel>/Production}"
        showValueHelp="true"
        valueHelpRequest="cflForProduction"
        placeholder="ManufacturingOrder" />

    <Input
        id="SerialNumber"
        width="100%"
        value="{EntryFormDataSourceModel>/SerialNum}"
        showValueHelp="true"
        valueHelpRequest="cflForSerial"
        placeholder="SerialNumber" />

        <HBox width="100%" justifyContent="End">
    <Button
        id="Go"
        type="Emphasized"
        text="{i18n>Go}"
        press="Go" />
</HBox>

</f:SimpleForm>


                        

  </VBox>
       
     

        <VBox id="fragmentContainer" class="sapUiSmallMargin">
        
                        <VBox id="fragment1Container"/>
                        <VBox id="fragment2Container"/>
                       <VBox id="fragment3Container"/>
                        <VBox id="fragment4Container"/>
                       
        

        </VBox>

      <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
              
              <Button
                    type="Emphasized"
                    id="_Print"
                    text="{i18n>Print}"
                    press="OnPrint"
                />
                <Button
                    type="Emphasized"
                    id="_save"
                    text="{i18n>Save}"
                    press="onSave"
                />
                
                <Button
                    type="Emphasized"
                    id="_cancel"
                    text="{i18n>Cancel}"
                    press="onCancel"
                />
            </Toolbar>
        </footer>

   
       

    </Page>


    

            
              
        

       
    
</mvc:View>