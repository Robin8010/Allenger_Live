{
  "_version": "1.76.0",
  "sap.app": {
    "id": "qcui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.3",
      "toolsId": "45bf59c1-80cc-462f-a4a8-5fbc0ee47e16"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/user-master/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.141.3",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    
   
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "qcui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    
    "sap.ui5": {
  "dependencies": {
    "libs": {
      "sap.ui.export": {}
    }
  }
},
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "qcui.view",
        "async": true,
        "viewPath": "qcui.view"
      },
      "routes": [
        {
          "name": "RouteLogin",
          "pattern": ":?query:",
          "target": [
            "TargetLogin"
          ]
        },
        {
          "name": "LandingPageIndex",
          "pattern": "LandingPageIndex",
          "target": [
            "LandingIndex"
          ]
        },
        
        {
          "name": "RouteNameUserMasterConfiguration",
          "pattern": "RouteNameUserMasterConfiguration",
          "target": [
            "TargetUserConfiguration"
          ],
          "cache": false
        },
        {
          "name": "RouterNameUserMasterEntryForm",
          "pattern": "RouterNameUserMasterEntryForm",
          "target": [
            "TargetUserMasterEntryForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameRecordResultViewForm",
          "pattern": "RecordResult",
          "target": [
            "TargetRecordResultViewForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameRecordResultEntryForm",
          "pattern": "RecordResultEntry",
          "target": [
            "TargetRecordResultEntryForm"
          ],
          "cache": false
        },
         {
          "name": "ProductQualityAssurance",
          "pattern": "ProductQualityAssurance",
          "target": [
            "TargetProductQualityAssurance"
          ],
          "cache": false
        },
        {
          
          "name": "RouterNameRecordResultSAPViewForm",
          "pattern": "SAPRecordResult",
          "target": [
            "TargetRecordResultSAPViewForm"
          ],
          "cache": false
        },
        {
          "name": "RecordResultListReport",
          "pattern": "DeviceListReport",
          "target": [
            "RecordResultListReport"
          ],
          "cache": false
        },
        {
          "name": "RouterNameRecordResultSAPEntryForm",
          "pattern": "SAPRecordResultEntry",
          "target": [
            "TargetRecordResultSAPEntryForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameRecordResultParametersEntryForm",
          "pattern": "SAPRecordResultParameters",
          "target": [
            "TargetRecordResultParametersEntryForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameRecordResultDeviceTaggingForm",
          "pattern": "SAPRecordResultDevices",
          "target": [
            "TargetRecordResultDeviceTaggingForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameStockTransferViewForm",
          "pattern": "StockTransfer",
          "target": [
            "TargetStockTransferViewForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameStockTransferEntryForm",
          "pattern": "SAPStockTransferEntry",
          "target": [
            "TargetStockTransferEntryForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameStockTransferSAPViewForm",
          "pattern": "Decision&Transfer",
          "target": [
            "TargetStockTransferSAPViewForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameStockTransferSAPEntryForm",
          "pattern": "SAPStockTransferEntry",
          "target": [
            "TargetStockTransferSAPEntryForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameInspectionLotDecisionForm",
          "pattern": "InspectionLotDecision",
          "target": [
            "TargetInspectionLotDecisionForm"
          ],
          "cache": false
        },
        {
          "name": "RouterNameInspectionLotStockTransferForm",
          "pattern": "InspectionLotStockTransfer",
          "target": [
            "TargetInspectionLotStockTransferForm"
          ],
          "cache": false
        },
        {
          "name": "InspectionLotReport",
          "pattern": "InspectionLotReport",
          "target": [
            "TargetInspectionLotReport"
          ],
          "cache": false
        },
         {
          "name": "DebitNoteLayout",
          "pattern": "DebitNoteLayout",
          "target": [
            "DebitNoteLayoutList"
          ]
        },
         {
          "name": "DispatchQuality",
          "pattern": "DispatchQuality",
          "target": [
            "DispatchQuality"
          ]
        },
         {
          "name": "DispatchQualityList",
          "pattern": "DispatchQualityList",
          "target": [
            "DispatchQualityList"
          ]
        },
         {
          "name": "ProductQualityAssuranceList",
          "pattern": "ProductQualityAssuranceList",
          "target": [
            "TargetProductQualityAssuranceList"
          ],
          "cache": false
        }
      ],
      "targets": {
        "TargetLogin": {
          "id": "Login",
          "name": "Login"
        },
        "LandingIndex": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "id": "Landing",
          "name": "Landing"
        },
        "TargetUserConfiguration": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "usermasterlistview",
          "viewName": "usermasterlistview",
          "viewPath": "modconfview"
        },
         "TargetProductQualityAssurance": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "ProductQualityAssurance",
          "viewName": "ProductQualityAssurance",
          "viewPath": "modconfview"
        },
         "DispatchQuality": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "DispatchQuality",
          "viewName": "DispatchQuality",
          "viewPath": "modconfview"
        },
        "DispatchQualityList": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "DispatchQualityList",
          "viewName": "DispatchQualityList",
          "viewPath": "modconfview"
        },
          "DebitNoteLayoutList": {
          "viewType": "XML",
          "transition": "slide",
          "viewId": "DebitNoteListForm",
          "viewName": "DebitNoteListForm",
          "viewPath" : "modconfview"
        },
        "TargetInspectionLotReport":{
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "InspectionLotReport",
          "viewName": "InspectionLotReport",
          "viewPath": "modconfview"
        },
        "TargetProductQualityAssuranceList":{
           "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "ProductQualityList",
          "viewName": "ProductQualityList",
          "viewPath": "modconfview"
        },
         "RecordResultListReport": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "InspectionLotReport",
          "viewName": "InspectionLotReport",
          "viewPath": "modconfview"
        },
        "TargetUserMasterEntryForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "usermasterentryform",
          "viewName": "usermasterentryform",
          "viewPath": "modconfview"
        },
        "TargetRecordResultViewForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "recordresultview",
          "viewName": "recordresultview",
          "viewPath": "modconfview"
        },
        "TargetRecordResultEntryForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "recordresultentry",
          "viewName": "recordresultentry",
          "viewPath": "modconfview"
        },
        "TargetRecordResultSAPViewForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "recordresultsapview",
          "viewName": "recordresultsapview",
          "viewPath": "modconfview"
        },
        "TargetRecordResultSAPEntryForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "recordresultsapentry",
          "viewName": "recordresultsapentry",
          "viewPath": "modconfview"
        },
        "TargetRecordResultParametersEntryForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "rrparametersentryform",
          "viewName": "rrparametersentryform",
          "viewPath": "modconfview"
        },
        "TargetRecordResultDeviceTaggingForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "DeviceTaggingform",
          "viewName": "DeviceTaggingform",
          "viewPath": "modconfview"
        },
        "TargetStockTransferViewForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "stocktransferview",
          "viewName": "stocktransferview",
          "viewPath": "modconfview"
        },
        "TargetStockTransferEntryForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "stocktransferentry",
          "viewName": "stocktransferentry",
          "viewPath": "modconfview"
        },
        "TargetStockTransferSAPViewForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "stocktransfersapview",
          "viewName": "stocktransfersapview",
          "viewPath": "modconfview"
        },
        "TargetStockTransferSAPEntryForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "stocktransfersapentry",
          "viewName": "stocktransfersapentry",
          "viewPath": "modconfview"
        },
        "TargetInspectionLotDecisionForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "inspectionlotdecisionform",
          "viewName": "inspectionlotdecisionform",
          "viewPath": "modconfview"
        },
        "TargetInspectionLotStockTransferForm": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "inspectionlotstocktransfer",
          "viewName": "inspectionlotstocktransfer",
          "viewPath": "modconfview"
        }
      }
    },
    "rootView": {
      "viewName": "qcui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}