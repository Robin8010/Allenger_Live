{
    "welcomeFile": "/qcui",
    "authenticationMethod": "none",
    "routes": [
        {
            "source": "^/qcui/(.*)$",
            "target": "$1",
            "destination": "ui5",
            "authenticationType": "none"
        },
        {
            "source": "^/qcui/(.*)$",
            "target": "$1",
            "service": "html5-apps-repo-rt",
            "authenticationType": "none"
        },
        {
            "source": "^/sap/(.*)$",
            "target": "$1",
            "destination": "S4HANA_ALLENGERS_Live",
            "authenticationType": "none",
            "csrfProtection": true
            
        },
        {
            "source": "^/(.*)$",
            "target": "$1",
            "destination": "srv-api",
            "authenticationType": "none",
            "csrfProtection": false
            
        },
        {
            "source": "^/app/(.*)$",
            "target": "$1",
            "localDir": ".",
            "cacheControl": "no-cache, no-store, must-revalidate"
        },
        {
            "source": "^/appconfig/",
            "localDir": ".",
            "cacheControl": "no-cache, no-store, must-revalidate"
        }
    ]
}
