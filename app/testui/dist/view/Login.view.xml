<mvc:View controllerName="testui.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
	xmlns:card="sap.f.cards">
    <VBox alignContent="Center" alignItems="Center" justifyContent="Center" >
        <f:Card class="sapUiMediumMarginTop" width="100%">
            <f:content>
                <VBox
                        width="45vh"
                        height="85vh"
                        class="sapUiMediumMarginBeginEnd"
                    >
                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="sapUiMediumMarginTop"
                        >
                        <Image
                            src=""
                            id="imgLogoctrl"
                        />
                        </HBox>
                        <HBox
                            justifyContent="Center"
                            class="sapUiMediumMarginBottom sapUiMediumMarginTop"
                        >
                            <core:Icon
                                src="sap-icon://person-placeholder"
                                size="4rem"
                            />
                        </HBox>
                        <HBox>
                            <Title
                                text="Sign in"
                                class="sapUiSmallMarginBottom titleTexttitleText"
                                textAlign="Center"
                            />
                        </HBox>

                        <Input
                            id="usernameInput"
                            type="Email"
                            valueLiveUpdate="true"
                            value="{EntryFormDataSourceModel>/UserName}"
                            liveChange=".onUsernameChange"
                            placeholder="Username"
                             submit=".onEnterPress"
                            class="sapUiSmallMarginBottom"
                        />
                        <Input
                            id="passwordInput"
                            type="Password"
                            valueLiveUpdate="true"
                              submit=".onEnterPress"
                            value="{EntryFormDataSourceModel>/Password}"
                            liveChange=".onPasswordChange"
                            placeholder="Password"
                            class="sapUiSmallMarginBottom"
                        />
                        <Link
                            text="Forgot password?"
                            textAlign="Center"
                            width="100%"
                            visible="false"

                        />

                        <VBox
                            height="100%"
                            justifyContent="End"
                            class="footer"
                        >
                            <FlexBox
                                justifyContent="End"
                                class="sapUiSmallMarginBottom"
                            >
                                <Button id="btnLogin"
                                    text="Sign in"
                                    press=".onPressLogin"
                                    type="Emphasized"
                                    width="auto"
                                    enabled="{EntryFormDataSourceModel>/buttonEnabled}"
                                />
                            </FlexBox>
                        </VBox>
                </VBox>
         </f:content>
        </f:Card>
     </VBox>
</mvc:View>