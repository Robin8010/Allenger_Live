<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    controllerName="modconfcontroller.recordresultentryform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
>
    <Page
        id="recordresultf"
        title="Record Result Form"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm backgroundDesign="Solid"
                editable="true"
                layout="ResponsiveGridLayout"
                maxContainerCols="2"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="3"
                emptySpanM="3"
                emptySpanS="0"
            >
                <f:content>
                <core:Title text="" />
                      <Label
                            id="inspectionlotlbl"
                            text="{i18n>inspectionlot}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inspectionLot"
                            value="{EntryFormDataSourceModel>/InspectionLot}"
                            required="true"
                            enabled="{EntryFormDataSourceModel>/InspectionLotEnabled}"
                            class="m-mast-input"
                            showValueHelp="true"
                            valueHelpRequest="cflForInspectionLot"     
                            placeholder="Select Inspection Lot"
                            change="ChangeInspectionLot"                       
                        />
                        <Label
                            id="materiallbl"
                            text="{i18n>Material}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inMaterial"
                            value="{EntryFormDataSourceModel>/Material}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="plantlbl"
                            text="{i18n>Plant}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inPlant"
                            value="{EntryFormDataSourceModel>/Plant}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="manageBylbl"
                            text="{i18n>Managed By}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inManageBy"
                            value="{EntryFormDataSourceModel>/ManagedBy}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="serialNolbl"
                            text="{i18n>Serial/Batch Number}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inSerialNo"
                            value="{EntryFormDataSourceModel>/SerialNumber}"
                            required="true"
                            enabled="{EntryFormDataSourceModel>/SerialNumberEnabled}"
                            class="m-mast-input"
                            valueHelpRequest="cflForInspectionSerial"
                            showValueHelp="true"                           
                            placeholder="Select Serial No"
                            change="ChangeSerialNumber"
                        />  
                        <Label
                            id="statuslbl"
                            text="{i18n>Status}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inSStatus"
                            value="{EntryFormDataSourceModel>/Status}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />  
                        
                         <core:Title text="" />                      
                        <Label
                            id="postdatelbl"
                            text="{i18n>PostDate}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <DatePicker
                            id="dtpostDate"
                            value="{EntryFormDataSourceModel>/PostDate}"
                            required="true"
                            enabled="{EntryFormDataSourceModel>/PostDateEnabled}"                            
                            valueFormat="yyyy-MM-dd" 
                            displayFormat="yyyy-MM-dd" 
                            class="customDisbaleColour"
                        />
                        <Label
                            id="eoilbl"
                            text="{i18n>EndOfInspection}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inEOI"
                            value="{EntryFormDataSourceModel>/EOI}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="quantitylbl"
                            text="{i18n>Quantity}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inQuantity"
                            value="{EntryFormDataSourceModel>/Quantity}"
                            required="true"
                            enabled="false"
                            class="m-mast-input"
                        />
                        <Label
                            id="acceptedQtylbl"
                            text="{i18n>Accepted Quantity}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inAcceptedQty"
                            value="{EntryFormDataSourceModel>/AcceptedQuantity}"
                            required="true"
                            enabled="true"
                            type="Number"
                            class="m-mast-input"
                            change="ValidateQuantity"
                        />
                        <Label
                            id="rejectedQtylbl"
                            text="{i18n>Rejected Quantity}"
                            required="true"
                            class="m-mast-lev"
                        /> 
                        <Input
                            id="inRejectedQty"
                            value="{EntryFormDataSourceModel>/RejectedQuantity}"
                            required="true"
                            enabled="true"
                            type="Number"
                            class="m-mast-input"
                            change="ValidateQuantity"
                        />
                </f:content>
            </f:SimpleForm>
        </VBox>   
        <VBox>
            <ScrollContainer
                width="100%"
                height="300px"
                horizontal="true"
                vertical="true"
            >
                <Table
                    id="smParameterTable"
                    items="{
                        path: 'EntryFormDataSourceModel>/ParameterDetails'
                    }"
                    class="sapUiSizeCompact"
                    inset="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                >
                    <columns>
                        <Column>
                            <Label text="Sr No" />
                        </Column>
                        <Column>
                            <Label
                                text="Inspection Parameter Id"
                                labelFor="ParameterCode"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Inspection Parameter Description"
                                labelFor="ParameterName"
                            />
                        </Column>      
                         <Column>
                            <Label
                                text="Characteristic/Attribute"
                                labelFor="Attribute"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Actual Result/Observation"
                                labelFor="Observation"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Inspection Method/Instrument ID"
                                labelFor="InstrumentId"
                            />
                        </Column>
                         <Column>
                            <Label
                                text="Inspection Method/Instrument Description"
                                labelFor="InstrumentDesc"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Status"
                                labelFor="Status"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Remarks1"
                                labelFor="Remarks1"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Remarks2"
                                labelFor="Remarks2"
                            />
                        </Column>       
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text
                                    id="il_SrNo2"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <Input
                                    id="il_ParameterCode"
                                    value="{EntryFormDataSourceModel>ParameterCode}"
                                />
                                <Input
                                    id="il_ParameterName"
                                    value="{EntryFormDataSourceModel>ParameterName}"
                                />
                                <Input
                                    id="il_Attribute"
                                    value="{EntryFormDataSourceModel>Attribute}"
                                />
                                <Input
                                    id="il_Observation"
                                    value="{EntryFormDataSourceModel>Observation}"
                                />
                                <Input
                                    id="il_InstrumentId"
                                    value="{EntryFormDataSourceModel>InstrumentId}"
                                />
                                <Input
                                    id="il_InstrumentDesc"
                                    value="{EntryFormDataSourceModel>InstrumentDesc}"
                                />
                                <ComboBox
                                    id="stageRole"
                                    required="true"
                                    valueState="None"
                                    visible="true"
                                    editable="true"
                                    selectedKey="{EntryFormDataSourceModel>Status}"
                                    items="{EntryFormDataSourceModel>/ParameterStatusList}"
                                > 
                                    <core:Item 
                                        key="{EntryFormDataSourceModel>StatusId}"
                                        text="{EntryFormDataSourceModel>StatusDesc}"
                                    />
                                </ComboBox>
                                <Input                                    
                                    id="il_Remarks1"
                                    value="{EntryFormDataSourceModel>Remarks1}"
                                />
                                <Input
                                    id="il_Remarks2"
                                    value="{EntryFormDataSourceModel>Remarks2}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>     
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button
                    type="Emphasized"
                    id="recordResult_Save"
                    text="{i18n>Save Draft}"
                    press="onSave"
                />
                <Button
                    type="Emphasized"
                    id="recordResult_Button"
                    text="{i18n>Submit}"
                    press="onSubmit"                    
                    enabled="{EntryFormDataSourceModel>/SubmitButtonEnabled}"                            
                />
                <Button
                    type="Emphasized"
                    id="recordResultCancel_Button"
                    text="{i18n>Cancel}"
                    press="onCancel"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>