<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
    controllerName="modconfcontroller.rrparametersentryform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
>
    <Page
        id="rrparametersf"
        title="Record Result Parameters"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
            >
                <f:content>
                    <Label
                        id="serialBatchlbl"
                        text="{i18n>SerialBatchNumber}"
                        required="true"
                        class="m-mast-lev"
                    />
                    <Input
                        id="rwContactID"
                        value="{EntryFormDataSourceModel>/SerialBatchNumber}"
                        required="true"
                        enabled="false"
                        class="m-mast-input"
                    />

                    <Label
                        id="rwQuantitylbl"
                        text="{i18n>Quantity}"
                        required="true"
                        class="m-mast-lev"
                    />
                    <Input
                        id="crQuantity"
                        value="{EntryFormDataSourceModel>/Quantity}"
                        required="true"
                        enabled="false"
                        class="m-mast-input"
                    />       
                    <Label
                        id="crStatuslbl"
                        text="{i18n>Status}"
                        required="true"
                        class="m-mast-lev"
                    />
                    <Input
                        id="crStatus"
                        value="{EntryFormDataSourceModel>/Status}"
                        required="true"
                        enabled="false"
                        class="m-mast-input"
                    />
                </f:content>
            </f:SimpleForm>
        </VBox>
        <VBox>
          <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                    <Button
                        icon="sap-icon://add"
                        text="{i18n>addNew}"
                        press="addRow"
                        visible="false"
                    />
                </VBox>
            </HBox>
            <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                     <SearchField placeholder="Search" liveChange="onSearch" value="{EntryFormDataSourceModel>/SearchRecord}"></SearchField>
                </VBox>
            </HBox>
            <ScrollContainer
                width="100%"
                height="300px"
                horizontal="true"
                vertical="true">
                <Table
                    id="smParameterTable1"
                    items="{
                        path: 'EntryFormDataSourceModel>/ParametersDetails'
                    }"
                    class="sapUiSizeCompact"
                    inset="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    growingScrollToLoad="true"
                  
                    backgroundDesign="Translucent"
                    
                >
                    <columns>
                        <Column>
                            <Label text="Sr No"  />
                        </Column>
                        <Column Width="300"
                             demandPopin="false">
                            <Label
                                text="Parameter Id"
                                labelFor="ParameterCode"
                                wrapping="true"
                                
                            />
                        </Column>
                         <Column >
                            <Label tooltip="Parameter Description"
                                text="Parameter Description"
                                labelFor="ParameterName"
                                
                            />
                        </Column>
                        <Column>   
                         <Label tooltip="Parent Parameter Id"
                                text="Parent Parameter Id"
                                labelFor="ParentParameterCode"
                            />
                        </Column>
                         <Column>
                            <Label tooltip="Parent Parameter Description"
                                text="Parent Parameter Description"
                                labelFor="ParentParameterName"
                            />
                        </Column>      
                         <Column>
                            <Label tooltip="Characteristic/Attribute"
                                text="Characteristic/Attribute"
                                labelFor="Attribute"
                            />
                        </Column>
                         <Column>
                            <Label tooltip="Actual Result/Observation"
                                text="Actual Result/Observation"
                                labelFor="Observation"
                            />
                        </Column>
                        <Column>
                            <Label tooltip="Inspection Method/Instrument ID"
                                text="Inspection Method/Instrument ID"
                                labelFor="InstrumentId"
                            />
                        </Column>
                         <Column>
                            <Label tooltip="Inspection Method/Instrument Description"
                                text="Inspection Method/Instrument Description"
                                labelFor="InstrumentDesc"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Status"
                                labelFor="Status"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Remarks1"
                                labelFor="Remarks1"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="Remarks2"
                                labelFor="Remarks2"
                            />
                        </Column>       
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text
                                    id="il_SrNo1"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <Text
                                    id="il_ParameterCode1"
                                    text="{EntryFormDataSourceModel>ParameterCode}"
                                    wrapping="true"
                                />
                                <Text
                                    id="il_ParameterName1"
                                    text="{EntryFormDataSourceModel>ParameterName}"
                                    wrapping="true"
                                />
                                 <Text
                                    id="il_PParameterCode1"
                                    text="{EntryFormDataSourceModel>ParentParameterCode}"
                                    wrapping="true"
                                />
                                <Text
                                    id="il_PParameterName1"
                                    text="{EntryFormDataSourceModel>ParentParameterName}"
                                    wrapping="true"
                                />
                                <Text
                                    id="il_Attribute1"
                                    text="{EntryFormDataSourceModel>Attribute}"
                                    wrapping="true"
                                />
                                <TextArea
                                    id="il_Observation1"
                                    value="{EntryFormDataSourceModel>Observation}"
                                    growing="true"
                                    editable="{EntryFormDataSourceModel>StatusEnableDisable}"
                                />
                                <Text
                                    id="il_InstrumentId1"
                                    text="{EntryFormDataSourceModel>InstrumentId}"
                                />
                                <Text
                                    id="il_InstrumentDesc1"
                                    text="{EntryFormDataSourceModel>InstrumentDesc}"
                                    wrapping="true"
                                />
                                <ComboBox
                                    id="rrpStatus"
                                    required="true"
                                    valueState="None"
                                    visible="true"
                                    editable="{EntryFormDataSourceModel>StatusEnableDisable}"
                                    selectedKey="{EntryFormDataSourceModel>Status}"
                                    items="{EntryFormDataSourceModel>/ParameterStatusList}"
                                > 
                                    <core:Item 
                                        key="{EntryFormDataSourceModel>StatusId}"
                                        text="{EntryFormDataSourceModel>StatusDesc}"
                                    />
                                </ComboBox>
                                <TextArea                                    
                                    id="il_Remarks11"
                                    value="{EntryFormDataSourceModel>Remarks1}"  
                                    growing="true"                                  
                                />
                                <TextArea
                                    id="il_Remarks21"
                                    value="{EntryFormDataSourceModel>Remarks2}"
                                    growing="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button
                    type="Emphasized"
                    id="CADS_Button"
                    text="{i18n>submit}"
                    press="onSave"
                />
                 <Button
                    type="Emphasized"
                    id="CADC_Button"
                    text="{i18n>cancel}"
                    press="onCancel"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>